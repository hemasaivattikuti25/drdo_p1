{
  "name": "drdo-dams",
  "version": "3.0.0",
  "description": "DRDO DAMS — Defence Asset Management System with FastAPI, MongoDB Replica Set & React",
  "scripts": {
    "server": "cd backend && uvicorn main:app --reload --port 8000",
    "client": "cd frontend && npm start",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "cd frontend && npm run build",
    "install-frontend": "cd frontend && npm install"
  },
  "keywords": [
    "drdo",
    "asset-management",
    "mongodb-replica-set",
    "fastapi",
    "react"
  ],
  "author": "Hemasai Vattikuti",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^7.6.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
