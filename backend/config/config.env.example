# ─────────────────────────────────────────────
# DRDO DAMS — Backend Environment Configuration
# Copy this file to config.env and fill in values
# ─────────────────────────────────────────────

# ── MongoDB ──────────────────────────────────
# Choose "replica" for 3-node Docker replica set, "standalone" for single-node
MONGO_DEFAULT_MODE=replica

# Standalone URI (single MongoDB instance)
MONGO_URI_STANDALONE=mongodb://localhost:27017/drdo_dams

# Replica Set URI (3-node — update hostnames/ports as needed)
MONGO_URI_REPLICA=mongodb://mongo1:27017,mongo2:27017,mongo3:27017/drdo_dams?replicaSet=rs0

# ── Authentication ────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_string_min_32_chars
JWT_EXPIRE_HOURS=24

# ── Email (Password Reset) ────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ── Frontend URL (for email links) ────────────
FRONTEND_URL=http://localhost:3000

# ── API Rate Limiting ─────────────────────────
# Max requests per minute per IP
RATE_LIMIT=100/minute
